{
    "name": "prestashopheaven/mono-build-tools",
    "description": "The PrestaHaven module factory: the ps-module command and its tools (build packages).",
    "version": "1.0.3",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "prestashopheaven/build-tools": "1.0.3"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.1",
        "prestashopheaven/build-tools": "*"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "phpcompatibility/php-compatibility": "^10.0@alpha"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "prestashopheaven": {
            "monorepo": {
                "kind": "build",
                "category": "tools"
            }
        }
    },
    "scripts": {
        "check": "ps-module mono check"
    }
}
